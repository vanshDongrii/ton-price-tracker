# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# ==============================================================================
# Crypto Market Provider Configuration
# ==============================================================================
# Supported providers: tonapi, binance, whitebit, coingecko
# Default: tonapi (TonAPI indexed DEX+CEX aggregates ensure sub-second accuracy)
CRYPTO_API_PROVIDER=tonapi
CRYPTO_API_KEY=

# Asset symbols
TON_SYMBOL=TON
TON_USDT_SYMBOL=TONUSDT

# ==============================================================================
# Foreign Exchange (USD -> INR) Configuration
# ==============================================================================
# Supported providers: exchangerate-api, frankfurter, coingecko
# Default: exchangerate-api (open public rates updated regularly, no API key required)
FX_API_PROVIDER=exchangerate-api
FX_API_KEY=

# FX Cache TTL in seconds (forex rates change much slower than crypto)
FX_CACHE_TTL_SECONDS=300

# ==============================================================================
# GRAM Token Configuration
# ==============================================================================
# GRAM on-chain jetton contract address on The Open Network (DEX indexed via TonAPI / STON.fi)
GRAM_CONTRACT_ADDRESS=EQC47093oX5Xhb0xuk2lCr2RhS8rj-vul61u4W2UH5ORmG_O
GRAM_CACHE_TTL_SECONDS=60

# ==============================================================================
# Telegram Stars Configuration
# ==============================================================================
# Supported sources: fragment, telegram_official, custom, none
# - fragment: Official Fragment Telegram Stars purchase pricing ($0.0150 USD / Star)
# - telegram_official: Official Telegram bot developer monetization rate ($0.013 USD / Star)
# - custom: Query endpoint configured in STARS_CUSTOM_API_URL
# - none: Report as unavailable
STARS_RATE_SOURCE=fragment
STARS_USD_RATE=0.015
# Optional static rate override (leave empty to calculate dynamically from live TON/USD price)
STARS_PER_TON=
STARS_RATE_API_KEY=
STARS_CUSTOM_API_URL=

# ==============================================================================
# Live Mode & Polling Behavior
# ==============================================================================
LIVE_MODE_ENABLED=true
# Telegram message update interval in seconds (throttles Telegram API edits)
LIVE_UPDATE_INTERVAL_SECONDS=5

# Threshold in seconds after which market data is marked as delayed/stale
PRICE_STALE_AFTER_SECONDS=15

# Global HTTP request timeout for REST fallback and external requests
API_TIMEOUT_SECONDS=5

# Rate limit: Minimum seconds between manual user refreshes
USER_REFRESH_COOLDOWN_SECONDS=3

# ==============================================================================
# Logging Configuration
# ==============================================================================
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
